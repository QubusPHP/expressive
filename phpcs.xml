<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Paths to check -->
    <file>ActiveRecord</file>
    <file>Connection</file>
    <file>DataMapper</file>
    <file>Helpers</file>
    <file>Migration</file>
    <file>Schema</file>
    <file>Traits</file>
    <file>Connection.php</file>
    <file>Database.php</file>
    <file>DbalException.php</file>
    <file>DsnGenerator.php</file>
    <file>Expression.php</file>
    <file>Identifier.php</file>
    <file>QueryBuilder.php</file>
    <file>QueryBuilderException.php</file>
    <file>ResultSet.php</file>
    <file>Schema.php</file>
    <file>Structure.php</file>

    <!-- Include rules from the Qubus Coding Standard -->
    <rule ref="QubusCodingStandard"/>
</ruleset>