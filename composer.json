{
    "name": "qubus/expressive",
    "type": "library",
    "description": "Database Abstraction Layer with DataMapper and ActiveRecord.",
    "keywords": ["database","querybuilder","dbal","database abstraction","orm","datamapper","activerecord"],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "fakerphp/faker": "^1.24",
        "qubus/config": "^4",
        "qubus/event-dispatcher": "^4",
        "qubus/inheritance": "^4",
        "qubus/support": "^4",
        "qubus/valueobjects": "^4",
        "symfony/console": "^7",
        "symfony/options-resolver": "^7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\Expressive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        "Qubus\\Tests\\Expressive\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
